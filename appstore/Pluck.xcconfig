PRODUCT_NAME = Pluck
PRODUCT_BUNDLE_IDENTIFIER = com.darius.mote
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 6
INFOPLIST_FILE = Info.plist
GENERATE_INFOPLIST_FILE = NO
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 73SRML6UTL
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_ENTITLEMENTS = Pluck.entitlements
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
COMBINE_HIDPI_IMAGES = YES
DEAD_CODE_STRIPPING = YES
LD_EXPORT_SYMBOLS = NO
GCC_SYMBOLS_PRIVATE_EXTERN = YES
GCC_WARN_UNUSED_PARAMETER = NO
GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS = NO
OTHER_LDFLAGS = $(inherited) -Wl,-objc_stubs_small -Wl,-const_selrefs -framework AppKit -framework Vision -framework Carbon -framework ScreenCaptureKit
SKIP_INSTALL = NO
INSTALL_PATH = $(LOCAL_APPS_DIR)
